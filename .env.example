ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://leek_user:change-me@localhost:5432/leek-quant
CONTAINER_DATABASE_URL=postgresql+asyncpg://leek_user:change-me@host.docker.internal:5432/leek-quant
