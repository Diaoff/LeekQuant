# These APIs are often blocked outside mainland China; use a VPN/proxy with a Chinese exit node.
# Example: DATA_PROXY_URL=http://127.0.0.1:7890
# DATA_PROXY_URL=
VITE_API_BASE_URL=http://localhost:8000
