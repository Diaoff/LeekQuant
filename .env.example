ENVIRONMENT=local
POSTGRES_DB=leek_quant
POSTGRES_USER=leek_user
# Required: set a strong password. Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://leek_user:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/leek_quant
CONTAINER_DATABASE_URL=postgresql+asyncpg://leek_user:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/leek_quant
REDIS_URL=redis://localhost:6379/0
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a proxy URL for internal Chinese financial data APIs (AData, Baostock, AkShare, EastMoney).
# These APIs are often blocked outside mainland China; use a VPN/proxy with a Chinese exit node.
# Example: DATA_PROXY_URL=http://127.0.0.1:7890
# DATA_PROXY_URL=
VITE_API_BASE_URL=http://localhost:8000
